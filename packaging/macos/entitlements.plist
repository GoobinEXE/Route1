<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements do Route Pico com hardened runtime (exigido pela notarização).
  O Python embutido usa ctypes/libffi (pywebview + PyObjC), que cria trampolins
  em memória executável: sem esta exceção o app fecha ao abrir a janela.
  Nada de sandbox, câmera, rede de entrada ou outras permissões.
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
